{
  "name": "staking-aggregator",
  "version": "1.0.0",
  "description": "Backend staking protocol routing aggregator that finds the best deal and executes transactions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:apy": "ts-node-dev --transpile-only test-apy.ts",
    "test:apis": "ts-node-dev --transpile-only test-apis.ts"
  },
  "keywords": [
    "staking",
    "aggregator",
    "defi",
    "routing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0"
  }
}
